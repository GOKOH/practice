            <h2 class="section-title">FINANCIAL PLAN</h2>
            <p class="text-center" style="margin-bottom:2rem; color:var(--color-gold-light);">資金計画シミュレーション</p>

            <div class="calc-wrapper">
                <!-- Inputs -->
                <div class="calc-inputs">
                    <h4 style="margin-bottom:1.5rem; border-bottom:1px solid rgba(255,255,255,0.3); padding-bottom:0.5rem;">基本条件設定</h4>
                    
