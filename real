<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>パーク・ハイム南荻窪三丁目 | 高級不動産物件案内</title>
    <meta name="description" content="荻窪駅徒歩10分、専有面積95平米超。三井不動産旧分譲の邸宅「パーク・ハイム南荻窪三丁目」。">
    <style>
        /* Base Reset & Fonts */
        :root {
            --color-navy: #1a2a44;
            --color-gold: #c5a059;
            --color-gold-light: #e0c895;
            --color-white: #ffffff;
            --color-gray-bg: #f5f5f5;
            --color-text: #333333;
            --font-base: "Helvetica Neue", Arial, "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
            --font-num: "Roboto", "Segoe UI", sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-base);
            color: var(--color-text);
            line-height: 1.6;
            background-color: var(--color-white);
            -webkit-font-smoothing: antialiased;
        }

        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }

        /* Typography & Utilities */
        .num {
            font-family: var(--font-num);
            font-feature-settings: "palt";
            vertical-align: baseline;
            font-weight: 500;
        }
        .text-center { text-align: center; }
        .text-gold { color: var(--color-gold); }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
        }
        .section-title {
            font-size: 2.2rem;
            color: var(--color-navy);
            text-align: center;
            margin-bottom: 3rem;
            letter-spacing: 0.1em;
            position: relative;
            padding-bottom: 1rem;
        }
        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background-color: var(--color-gold);
        }

        /* Hero Section */
        .hero {
            position: relative;
            height: 80vh;
            min-height: 600px;
            background: linear-gradient(rgba(26,42,68,0.4), rgba(26,42,68,0.7)), url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1920&q=80'); /* Sample Image */
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-white);
            text-align: center;
        }
        .hero-content h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: 0.05em;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        }
        .hero-content p {
            font-size: 1.2rem;
            letter-spacing: 0.1em;
            margin-bottom: 2rem;
        }
        .hero-tag {
            background-color: var(--color-gold);
            color: var(--color-navy);
            padding: 8px 16px;
            font-size: 0.9rem;
            font-weight: bold;
            display: inline-block;
            margin-bottom: 1rem;
        }

        /* Image Badge */
        .sample-badge {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background-color: rgba(0,0,0,0.7);
            color: white;
            padding: 4px 8px;
            font-size: 0.7rem;
            border-radius: 2px;
            z-index: 10;
        }

        /* The Residence (Features) */
        .residence {
            padding: 5rem 0;
            background-color: var(--color-white);
        }
        .spec-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }
        .spec-card {
            background: #fff;
            border: 1px solid #eee;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            padding: 2rem;
            transition: transform 0.3s;
        }
        .spec-card:hover {
            transform: translateY(-5px);
            border-color: var(--color-gold);
        }
        .spec-label {
            color: var(--color-gold);
            font-size: 0.9rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
            display: block;
        }
        .spec-value {
            font-size: 1.5rem;
            color: var(--color-navy);
            font-weight: bold;
        }
        .points-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }
        .point-item {
            display: flex;
            align-items: flex-start;
        }
        .point-icon {
            color: var(--color-gold);
            margin-right: 10px;
            font-size: 1.2rem;
        }

        /* Area Value */
        .area {
            padding: 5rem 0;
            background-color: var(--color-gray-bg);
        }
        .area-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
        }
        .area-text h3 {
            color: var(--color-navy);
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }
        .area-image {
            position: relative;
            height: 300px;
            background: url('https://images.unsplash.com/photo-1542051841857-5f90071e7989?auto=format&fit=crop&w=800&q=80') center/cover; /* Sample Tokyo Street */
            border-radius: 4px;
            overflow: hidden;
        }

        /* Financial Plan (Calculator) */
        .financial {
            padding: 5rem 0;
            background-color: var(--color-navy);
            color: var(--color-white);
        }
        .financial .section-title {
            color: var(--color-white);
        }
        .financial .section-title::after {
            background-color: var(--color-gold);
        }
        
        .calc-wrapper {
            background-color: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 2rem;
            border-radius: 8px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
        }

        .calc-inputs {
            padding-right: 2rem;
            border-right: 1px solid rgba(255,255,255,0.1);
        }
        .calc-results {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }
        .input-group label {
            display: block;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            color: var(--color-gold-light);
        }
        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }
        .input-wrapper input {
            width: 100%;
            padding: 10px 15px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            font-size: 1.1rem;
            font-family: var(--font-num);
            border-radius: 4px;
            transition: 0.3s;
        }
        .input-wrapper input:focus {
            outline: none;
            border-color: var(--color-gold);
            background: rgba(255,255,255,0.15);
        }
        .unit {
            position: absolute;
            right: 15px;
            color: rgba(255,255,255,0.6);
            font-size: 0.9rem;
        }

        .details-accordion {
            margin-top: 2rem;
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 1rem;
        }
        .details-toggle {
            background: none;
            border: none;
            color: var(--color-gold);
            cursor: pointer;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            padding: 0;
        }
        .details-toggle::before {
            content: '+';
            margin-right: 5px;
            font-weight: bold;
        }
        .details-content {
            display: none; /* JSで制御 */
            margin-top: 1rem;
            font-size: 0.9rem;
        }
        .details-content.open { display: block; }
        
        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.8rem;
            align-items: center;
        }
        .detail-row input {
            width: 100px;
            padding: 5px;
            text-align: right;
            background: rgba(0,0,0,0.2);
            border: 1px solid rgba(255,255,255,0.1);
            color: white;
            font-size: 0.9rem;
        }

        .result-box {
            text-align: center;
            margin-bottom: 2rem;
            padding: 2rem;
            background: rgba(197, 160, 89, 0.1);
            border: 1px solid var(--color-gold);
            border-radius: 8px;
        }
        .result-label {
            font-size: 1rem;
            margin-bottom: 0.5rem;
            display: block;
        }
        .result-value {
            font-size: 3rem;
            color: var(--color-gold);
            font-weight: 700;
            line-height: 1.2;
        }
        .result-sub {
            font-size: 0.9rem;
            opacity: 0.8;
            margin-top: 0.5rem;
        }
        
        .breakdown-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }
        .breakdown-table td {
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .breakdown-table .text-right { text-align: right; }

        /* Footer */
        footer {
            background-color: #111;
            color: #fff;
            padding: 4rem 0 2rem;
            text-align: center;
            font-size: 0.9rem;
        }
        .footer-logo {
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 1rem;
            letter-spacing: 0.1em;
        }
        .footer-info p {
            margin-bottom: 0.5rem;
            opacity: 0.8;
        }
        .footer-link {
            color: var(--color-gold);
            text-decoration: underline;
            transition: 0.3s;
        }
        .footer-link:hover { color: var(--color-white); }
        .copyright {
            margin-top: 3rem;
            opacity: 0.4;
            font-size: 0.8rem;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .hero-content h1 { font-size: 2rem; }
            .area-content { grid-template-columns: 1fr; }
            .calc-wrapper { grid-template-columns: 1fr; gap: 2rem; }
            .calc-inputs { border-right: none; padding-right: 0; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 2rem; }
        }
    </style>
</head>
