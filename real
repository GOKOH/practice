    <script>
        // Formatter
        const formatter = new Intl.NumberFormat('ja-JP');

        function toggleDetails() {
            const content = document.getElementById('detailsContent');
            content.classList.toggle('open');
            const btn = document.querySelector('.details-toggle');
            btn.innerHTML = content.classList.contains('open') ? '- 諸費用内訳を閉じる' : '+ 諸費用内訳を編集する';
        }

        // Logic
        function updateCalculation() {
            // 1. Get Inputs
            const price = parseFloat(document.getElementById('price').value) || 0;
            const downPayment = parseFloat(document.getElementById('downPayment').value) || 0;
            const interestRate = (parseFloat(document.getElementById('interestRate').value) || 0) / 100;
            const years = parseFloat(document.getElementById('years').value) || 35;
            const mgmtFee = parseFloat(document.getElementById('managementFee').value) || 0;

            // 2. Calculate Costs (Auto-fill inputs if not overridden, but here we just recalc for simplicity)
            // Brokerage Fee
            const brokerage = Math.floor((price * 0.03 + 60000) * 1.1);
            document.getElementById('costBrokerage').value = brokerage;

            // Stamp Duty (Sales)
            let stampSales = 0;
            if (price > 10000000 && price <= 50000000) stampSales = 10000;
            else if (price > 50000000 && price <= 100000000) stampSales = 30000;
            else if (price > 100000000 && price <= 500000000) stampSales = 60000;
            document.getElementById('costStampSales').value = stampSales;

            // Get fixed/manual costs
            const costRegistration = parseFloat(document.getElementById('costRegistration').value) || 0;
            const costTaxAdjust = parseFloat(document.getElementById('costTaxAdjust').value) || 0;
            const costFireInsurance = parseFloat(document.getElementById('costFireInsurance').value) || 0;
            const costOthers = parseFloat(document.getElementById('costOthers').value) || 0;

            // Intermediate Calculation for Loan Amount (to calculate loan fee & stamp loan)
            // Temporary total costs without Loan Fee & Stamp Loan
            let tempTotalCosts = brokerage + costRegistration + costTaxAdjust + stampSales + costFireInsurance + costOthers;
            
            // Temporary Loan Amount
            let tempLoanAmount = price + tempTotalCosts - downPayment;
            if(tempLoanAmount < 0) tempLoanAmount = 0;

            // Calculate Loan Fee
            const loanFee = Math.floor(tempLoanAmount * 0.022);
            document.getElementById('costLoanFee').value = loanFee;

            // Calculate Stamp Duty (Loan)
            let stampLoan = 0;
            if (tempLoanAmount > 10000000 && tempLoanAmount <= 50000000) stampLoan = 20000; // 消費貸借契約書印紙税（一般）
            else if (tempLoanAmount > 50000000 && tempLoanAmount <= 100000000) stampLoan = 60000;
            else if (tempLoanAmount > 100000000 && tempLoanAmount <= 500000000) stampLoan = 100000;
            // *Note: Web contract discounts usually apply but using standard paper contract rates for safety/max estimation.
            // Adjusting based on user prompt logic which said "same as sales" logic roughly, but strictly loan agreements have different brackets.
            // Re-reading prompt: "印紙代(金消): 借入額に応じて判定 (同上)". "同上" implies the same logic as Sales contract (reduced rate for real estate transfer).
            // Real estate transfer reduced tax: 10M-50M=10k, 50M-100M=30k.
            // Loan agreement (Promissory note/Loan) is NOT eligible for that specific reduction usually, but let's follow the "same as above" instruction strictly for the "logic".
            if (tempLoanAmount > 10000000 && tempLoanAmount <= 50000000) stampLoan = 10000;
            else if (tempLoanAmount > 50000000 && tempLoanAmount <= 100000000) stampLoan = 30000;
            else if (tempLoanAmount > 100000000 && tempLoanAmount <= 500000000) stampLoan = 60000;
            
            document.getElementById('costStampLoan').value = stampLoan;

            // 3. Final Total Calculation
            const finalTotalCosts = brokerage + costRegistration + costTaxAdjust + stampSales + stampLoan + loanFee + costFireInsurance + costOthers;
            const finalLoanAmount = price + finalTotalCosts - downPayment;
            const borrowAmount = finalLoanAmount > 0 ? finalLoanAmount : 0;

            // 4. Monthly Payment Calculation
            // PMT formula: P * r * (1 + r)^n / ((1 + r)^n - 1)
            // r = monthly interest rate, n = total months
            let monthlyPayment = 0;
            if (borrowAmount > 0 && interestRate > 0) {
                const r = interestRate / 12;
                const n = years * 12;
                monthlyPayment = Math.floor(borrowAmount * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1));
            } else if (borrowAmount > 0 && interestRate === 0) {
                monthlyPayment = Math.floor(borrowAmount / (years * 12));
            }

            const totalMonthly = monthlyPayment + mgmtFee;

            // 5. Update UI
            document.getElementById('totalMonthlyPayment').innerText = formatter.format(totalMonthly);
            document.getElementById('loanMonthlyPayment').innerText = formatter.format(monthlyPayment);
            document.getElementById('mgmtFeeDisplay').innerText = formatter.format(mgmtFee);
            
            document.getElementById('displayPrice').innerText = formatter.format(price);
            document.getElementById('displayTotalCosts').innerText = formatter.format(finalTotalCosts);
            document.getElementById('displayDownPayment').innerText = formatter.format(downPayment);
            document.getElementById('displayLoanAmount').innerText = formatter.format(borrowAmount);
        }

        // Initialize
        window.onload = updateCalculation;
    </script>
</body>
</html>
